# GitHub OAuth App 설정 (docs/GITHUB_OAUTH.md 참고)
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 Git에 올리지 마세요.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 브라우저로 접속하는 주소. GitHub OAuth App의 콜백 URL은 {APP_URL}/auth/github/callback
# - 개발(npm run dev): http://localhost:5173
# - 배포 빌드(npm run build && npm start): http://localhost:3000
APP_URL=http://localhost:5173

# 선택
PORT=3000
DATABASE_PATH=./data/todo.db
SESSION_TTL_DAYS=7
